# Media OS local development template.
# Copy to .env for local use. Never commit .env or place real secrets here.

APP_ENV=local
API_PORT=8080
DASHBOARD_PORT=5173

# Metadata backend: local mock mode is the default in Stage 0.
METADATA_PROVIDER=memory

# Media worker
MEDIA_OUTPUT_DIR=./media-output
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Optional provider configuration: leave empty until a provider is selected.
LLM_PROVIDER=mock
LLM_API_KEY=
TTS_PROVIDER=mock
TTS_API_KEY=
VISUAL_PROVIDER=mock
VISUAL_API_KEY=

# Google Cloud: configure only after a user-approved deployment.
GCP_PROJECT_ID=
GCP_REGION=asia-south1
GCP_STORAGE_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=

# YouTube OAuth: not used by Stage 0. Never commit token or client-secret files.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8080/api/v1/integrations/youtube/callback
